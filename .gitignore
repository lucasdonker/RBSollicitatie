# ── Paal 13 Sollicitatiesysteem — .gitignore ──
# Houdt geheimen en per-server data buiten Git.

# Configuratie met wachtwoorden (database, SMTP, OIDC).
# Elke server (test/productie) heeft zijn EIGEN config.php die hier NIET in Git staat.
# Het veilige voorbeeld config.template.php gaat WEL mee.
includes/config.php

# Door gebruikers geüploade bestanden (BLK-foto's e.d.) — per server, niet in Git.
uploads/

# Automatische backups van de oude deploy-tool — per server, groot, niet in Git.
_backups/

# Losse ZIP-bundels en archieven.
*.zip

# De opmaak en het script van de WordPress-plugin zijn kopieën van assets/css en assets/js.
# Twee kopieën van hetzelfde bestand in één repository lopen uit elkaar; wordpress-plugin/
# bouw-zip.ps1 zet er verse in bij het maken van de ZIP. Zie assets/LEESMIJ.txt daar.
wordpress-plugin/paal13-aanmelden/assets/aanmeldformulier.css
wordpress-plugin/paal13-aanmelden/assets/aanmeldformulier.js

# Logbestanden.
*.log
error_log

# Tijdelijke en systeem-bestanden.
*.tmp
*.bak
.DS_Store
Thumbs.db

# Editor-mappen.
.vscode/
.idea/
CLAUDE.md
/docs/ai
