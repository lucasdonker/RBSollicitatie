# Paal 13 sollicitatiesysteem — Apache-configuratie
# Minimale, veilige rewrite voor nette landingspagina-URL's: /l/<slug> → l.php?p=<slug>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nette landingspagina-URL's: /l/mijn-slug  →  l.php?p=mijn-slug
    # Alleen letters, cijfers en koppeltekens in de slug.
    RewriteRule ^l/([a-zA-Z0-9\-]+)/?$ l.php?p=$1 [L,QSA]

    # Korte downloadlinks voor bijlagen: /d/<id>-<verloopt>-<token>  →  download.php?d=...
    RewriteRule ^d/([0-9]+-[0-9]+-[a-f0-9]+)/?$ download.php?d=$1 [L]
</IfModule>

# Eigen 404-pagina (huisstijl) voor adressen die niet bestaan, ook onder /portaal/ en /admin/
ErrorDocument 404 /404.php

# Toon geen PHP-fouten aan bezoekers (fouten gaan naar het log)
<IfModule mod_php.c>
    php_flag display_errors Off
</IfModule>
